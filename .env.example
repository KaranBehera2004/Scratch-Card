PORT=5051

# Optional locally, but required for the production Render API.
# Keep the real value in .env or hosting environment variables; never commit it.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scratch_cards
CLIENT_ORIGIN=http://localhost:5174
# Render production: CLIENT_ORIGIN=https://scratch.justconnect.biz
# Production API: https://api-scratch.justconnect.biz (requests use /api/*).
# See .env.production.example for the server's production environment variables.

# Required for portal sign-in. Use a long, private value and add the same value
# in Render Environment Variables. Never expose it in frontend code.
AUTH_SECRET=replace-with-a-long-random-private-secret
SUPER_ADMIN_LOGIN_ID=admin@luckydrop.local
SUPER_ADMIN_PASSWORD=replace-with-a-strong-super-admin-password

# Initial Impact Vibes business account, seeded once. This user can access only the
# Impact Vibes workspace and its own scratch cards.
IMPACT_VIBES_EMAIL=impactvibes@admin.local
IMPACT_VIBES_PASSWORD=replace-with-a-strong-impact-vibes-password
