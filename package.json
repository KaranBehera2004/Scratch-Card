{
  "name": "scratch-card-offer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "test": "node --test server/control.test.js server/indexes.test.js server/bulk.test.js client/src/bulk-coupons.test.js client/src/campaigns.test.js client/src/coupon-filters.test.js shared/whatsapp.test.js",
    "test:ui": "npm run build && playwright test",
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "node --watch server/index.js",
    "build": "npm --workspace client run build",
    "preview": "npm --workspace client run preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.19.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
