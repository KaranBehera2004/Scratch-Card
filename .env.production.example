# Reference values for the Render API's Environment settings.
# Replace placeholders there; never commit actual credentials to this file.
# Vercel hosts only the frontend and does not need these database/login secrets.
NODE_ENV=production
NODE_VERSION=24.x
CLIENT_ORIGIN=https://scratch.justconnect.biz
MONGODB_URI=replace-with-your-existing-mongodb-connection-string
MONGODB_DB=scratch_cards
AUTH_SECRET=replace-with-your-existing-private-auth-secret
SUPER_ADMIN_LOGIN_ID=replace-with-your-existing-super-admin-login-id
SUPER_ADMIN_PASSWORD=replace-with-your-existing-super-admin-password

# Render provides PORT. API health: https://api-scratch.justconnect.biz/api/health
# Preserve the existing database name and credentials when migrating domains.
# Add IMPACT_VIBES_EMAIL / IMPACT_VIBES_PASSWORD only when seeding that account.
